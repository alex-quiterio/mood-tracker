{
  "expo": {
    "name": "Mood Tracker",
    "slug": "mood-tracker",
    "version": "1.17.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2A1E52",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.alexquiterio.moodtracker",
      "versionCode": 29,
      "permissions": ["android.permission.USE_EXACT_ALARM", "android.permission.SCHEDULE_EXACT_ALARM"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      "expo-notifications",
      "expo-localization",
      "expo-local-authentication",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Figtree-Regular.ttf",
            "./assets/fonts/Figtree-Medium.ttf",
            "./assets/fonts/Figtree-SemiBold.ttf",
            "./assets/fonts/Figtree-Bold.ttf",
            "./assets/fonts/Figtree-ExtraBold.ttf",
            "./assets/fonts/Fraunces-Regular.ttf",
            "./assets/fonts/Fraunces-SemiBold.ttf",
            "./assets/fonts/Fraunces-Bold.ttf",
            "./assets/fonts/Fraunces-Italic.ttf",
            "./assets/fonts/Fraunces-SemiBoldItalic.ttf"
          ]
        }
      ]
    ]
  }
}
