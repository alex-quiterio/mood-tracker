<?xml version="1.0" encoding="utf-8"?>
<!--
  Greeting and pause, today's three check-ins as mood-coloured tiles, the week as dots
  and the quote of the day. MoodWidgetProvider fills in the text and colours, and hides
  the week and quote when the widget is too short for them.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/mood_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <ImageView
    android:id="@+id/mood_widget_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    android:scaleType="fitXY"
    android:src="@drawable/mood_widget_background"
    android:tint="@color/mood_widget_surface" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <TextView
        android:id="@+id/mood_widget_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/mood_widget_today"
        android:textColor="@color/mood_widget_text"
        android:textSize="16sp"
        android:textStyle="bold" />
      <TextView
        android:id="@+id/mood_widget_pause"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="40dp"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:text="@string/mood_widget_pause"
        android:textColor="@color/mood_widget_accent"
        android:textSize="14sp"
        android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_marginHorizontal="-3dp"
      android:layout_weight="1"
      android:minHeight="64dp"
      android:orientation="horizontal">
      <FrameLayout
        android:id="@+id/mood_widget_slot_morning"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="3dp"
        android:layout_weight="1">
        <ImageView
          android:id="@+id/mood_widget_tile_morning"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:importantForAccessibility="no"
          android:scaleType="fitXY"
          android:src="@drawable/mood_widget_tile"
          android:tint="@color/mood_widget_empty" />
        <ImageView
          android:id="@+id/mood_widget_ring_morning"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:importantForAccessibility="no"
          android:scaleType="fitXY"
          android:src="@drawable/mood_widget_ring"
          android:tint="@color/mood_widget_accent"
          android:visibility="gone" />
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:gravity="center"
          android:orientation="vertical">
          <TextView
            android:id="@+id/mood_widget_emoji_morning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="○"
            android:textColor="@color/mood_widget_muted"
            android:textSize="24sp" />
          <TextView
            android:id="@+id/mood_widget_label_morning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/mood_widget_morning"
            android:textColor="@color/mood_widget_muted"
            android:textSize="12sp" />
        </LinearLayout>
      </FrameLayout>
      <FrameLayout
        android:id="@+id/mood_widget_slot_afternoon"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="3dp"
        android:layout_weight="1">
        <ImageView
          android:id="@+id/mood_widget_tile_afternoon"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:importantForAccessibility="no"
          android:scaleType="fitXY"
          android:src="@drawable/mood_widget_tile"
          android:tint="@color/mood_widget_empty" />
        <ImageView
          android:id="@+id/mood_widget_ring_afternoon"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:importantForAccessibility="no"
          android:scaleType="fitXY"
          android:src="@drawable/mood_widget_ring"
          android:tint="@color/mood_widget_accent"
          android:visibility="gone" />
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:gravity="center"
          android:orientation="vertical">
          <TextView
            android:id="@+id/mood_widget_emoji_afternoon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="○"
            android:textColor="@color/mood_widget_muted"
            android:textSize="24sp" />
          <TextView
            android:id="@+id/mood_widget_label_afternoon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/mood_widget_afternoon"
            android:textColor="@color/mood_widget_muted"
            android:textSize="12sp" />
        </LinearLayout>
      </FrameLayout>
      <FrameLayout
        android:id="@+id/mood_widget_slot_evening"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="3dp"
        android:layout_weight="1">
        <ImageView
          android:id="@+id/mood_widget_tile_evening"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:importantForAccessibility="no"
          android:scaleType="fitXY"
          android:src="@drawable/mood_widget_tile"
          android:tint="@color/mood_widget_empty" />
        <ImageView
          android:id="@+id/mood_widget_ring_evening"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:importantForAccessibility="no"
          android:scaleType="fitXY"
          android:src="@drawable/mood_widget_ring"
          android:tint="@color/mood_widget_accent"
          android:visibility="gone" />
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:gravity="center"
          android:orientation="vertical">
          <TextView
            android:id="@+id/mood_widget_emoji_evening"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="○"
            android:textColor="@color/mood_widget_muted"
            android:textSize="24sp" />
          <TextView
            android:id="@+id/mood_widget_label_evening"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/mood_widget_evening"
            android:textColor="@color/mood_widget_muted"
            android:textSize="12sp" />
        </LinearLayout>
      </FrameLayout>
    </LinearLayout>

    <LinearLayout
      android:id="@+id/mood_widget_week"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:orientation="horizontal"
      android:visibility="gone">
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
          android:id="@+id/mood_widget_dot_0"
          android:layout_width="14dp"
          android:layout_height="14dp"
          android:importantForAccessibility="no"
          android:src="@drawable/mood_widget_dot"
          android:tint="@color/mood_widget_empty" />
        <TextView
          android:id="@+id/mood_widget_day_0"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:textColor="@color/mood_widget_muted"
          android:textSize="10sp" />
      </LinearLayout>
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
          android:id="@+id/mood_widget_dot_1"
          android:layout_width="14dp"
          android:layout_height="14dp"
          android:importantForAccessibility="no"
          android:src="@drawable/mood_widget_dot"
          android:tint="@color/mood_widget_empty" />
        <TextView
          android:id="@+id/mood_widget_day_1"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:textColor="@color/mood_widget_muted"
          android:textSize="10sp" />
      </LinearLayout>
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
          android:id="@+id/mood_widget_dot_2"
          android:layout_width="14dp"
          android:layout_height="14dp"
          android:importantForAccessibility="no"
          android:src="@drawable/mood_widget_dot"
          android:tint="@color/mood_widget_empty" />
        <TextView
          android:id="@+id/mood_widget_day_2"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:textColor="@color/mood_widget_muted"
          android:textSize="10sp" />
      </LinearLayout>
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
          android:id="@+id/mood_widget_dot_3"
          android:layout_width="14dp"
          android:layout_height="14dp"
          android:importantForAccessibility="no"
          android:src="@drawable/mood_widget_dot"
          android:tint="@color/mood_widget_empty" />
        <TextView
          android:id="@+id/mood_widget_day_3"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:textColor="@color/mood_widget_muted"
          android:textSize="10sp" />
      </LinearLayout>
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
          android:id="@+id/mood_widget_dot_4"
          android:layout_width="14dp"
          android:layout_height="14dp"
          android:importantForAccessibility="no"
          android:src="@drawable/mood_widget_dot"
          android:tint="@color/mood_widget_empty" />
        <TextView
          android:id="@+id/mood_widget_day_4"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:textColor="@color/mood_widget_muted"
          android:textSize="10sp" />
      </LinearLayout>
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
          android:id="@+id/mood_widget_dot_5"
          android:layout_width="14dp"
          android:layout_height="14dp"
          android:importantForAccessibility="no"
          android:src="@drawable/mood_widget_dot"
          android:tint="@color/mood_widget_empty" />
        <TextView
          android:id="@+id/mood_widget_day_5"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:textColor="@color/mood_widget_muted"
          android:textSize="10sp" />
      </LinearLayout>
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
          android:id="@+id/mood_widget_dot_6"
          android:layout_width="14dp"
          android:layout_height="14dp"
          android:importantForAccessibility="no"
          android:src="@drawable/mood_widget_dot"
          android:tint="@color/mood_widget_empty" />
        <TextView
          android:id="@+id/mood_widget_day_6"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:textColor="@color/mood_widget_muted"
          android:textSize="10sp" />
      </LinearLayout>
    </LinearLayout>

    <LinearLayout
      android:id="@+id/mood_widget_quote"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:orientation="vertical"
      android:visibility="gone">
      <TextView
        android:id="@+id/mood_widget_quote_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="@color/mood_widget_text"
        android:textSize="13sp"
        android:textStyle="italic" />
      <TextView
        android:id="@+id/mood_widget_quote_source"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/mood_widget_muted"
        android:textSize="11sp" />
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
