{
  "name": "mood-tracker",
  "version": "1.24.2",
  "main": "index.ts",
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.33",
    "expo-constants": "~57.0.24",
    "expo-crypto": "~57.0.4",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-keep-awake": "~57.0.2",
    "expo-local-authentication": "~57.0.3",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.25",
    "expo-screen-capture": "~57.0.4",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.26",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@domain/(.*)$": "<rootDir>/src/domain/$1",
      "^@infrastructure/(.*)$": "<rootDir>/src/infrastructure/$1",
      "^@ui/(.*)$": "<rootDir>/src/ui/$1",
      "^@modules/(.*)$": "<rootDir>/modules/$1"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|@noble))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    },
    "glob@^13": "^14.0.2",
    "minimatch@^10": "^11.0.1"
  }
}
