{
  "name": "Feelings Unboxed",
  "short_name": "Unboxed",
  "description": "Open Mood Tracker backups, encrypted or not, on your device.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#5B4FCF",
  "theme_color": "#5B4FCF",
  "icons": [
    { "src": "icon.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": { "application/json": [".json"] }
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "file", "accept": ["application/json", ".json", "text/plain"] }]
    }
  }
}
